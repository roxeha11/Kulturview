        if my_items:
            st.markdown("**Meine Angebote:**")
            for item in my_items:
                st.markdown(f"""
                <div class='kl-card'>
                    <b>{item['titel']}</b> · <span class='kl-price'>{item['preis']} €</span>
                    · Status: {item['status']}
                </div>
                """, unsafe_allow_html=True)

        st.markdown("---")
        st.markdown("**Neuen Artikel einstellen:**")
        with st.form("sell_form"):
            s1, s2 = st.columns(2)
            with s1:
                s_titel = st.text_input("Titel")
                s_kat   = st.selectbox("Kategorie", ["Gemälde","Fotografie","Skulptur","Digital Art","Textil","Sonstiges"])
                s_preis = st.number_input("Preis (€)", min_value=1, value=100)
            with s2:
                s_bild  = st.file_uploader("📸 Bild hochladen", type=["jpg","jpeg","png"])
                s_desc  = st.text_area("Beschreibung")
            s_btn = st.form_submit_button("📦 Einstellen", use_container_width=True)
        if s_btn and s_titel.strip() and s_desc.strip():
            bild_path = None
            if s_bild:
                fname = f"{uuid.uuid4()}.{s_bild.name.split('.')[-1]}"
                bild_path = save_media(s_bild, "market", fname)
            market.append(dict(
                id=str(uuid.uuid4()), verkäufer=st.session_state.username,
                titel=s_titel.strip(), beschreibung=s_desc.strip(),
                kategorie=s_kat, preis=s_preis, status="verfügbar",
                bild=bild_path, datum=datetime.now().strftime("%d.%m.%Y")
            ))
            save_json(MARKET_FILE, market)
            st.success(f"✅ '{s_titel}' wurde eingestellt!")
            st.rerun()

    # ── INBOX ───────────────────────────────────────────────
    with sub[3]:
        st.markdown("<div class='kl-section-title'>💬 Marketplace-Inbox</div>", unsafe_allow_html=True)
        chats = load_json(CHATS_FILE, DEMO_CHATS)
        my_chats = {k: v for k, v in chats.items() if st.session_state.username in k}
        if not my_chats:
            st.info("Noch keine Marketplace-Nachrichten.")
        else:
            for key, msgs in my_chats.items():
                parts = key.split("__")
                other = next((p for p in parts if p != st.session_state.username), parts[0])
                other_inf = next((u for u in DEMO_USERS_EXTRA if u["benutzername"]==other), dict(name=other))
                with st.expander(f"💬 {other_inf['name']}"):
                    for msg in msgs[-10:]:
                        if msg["von"] == st.session_state.username:
                            st.markdown(f'<div class="msg-sent">{msg["text"]}</div>', unsafe_allow_html=True)
                        else:
                            st.markdown(f'<div class="msg-recv">{msg["text"]}</div>', unsafe_allow_html=True)
                    with st.form(f"inbox_{key}", clear_on_submit=True):
                        ic1, ic2 = st.columns([5,1])
                        with ic1: im = st.text_input("Antworten...", label_visibility="collapsed")
                        with ic2: isend = st.form_submit_button("↑")
                    if isend and im.strip():
                        chats[key].append(dict(von=st.session_state.username, text=im.strip(), zeit=datetime.now().strftime("%H:%M")))
                        save_json(CHATS_FILE, chats); st.rerun()

